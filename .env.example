# Copie para .env. Nunca commite o .env real.
RAG_LLM_PROVIDER=openai_compatible
RAG_LLM_MODEL=local
RAG_LLM_TEMPERATURE=0.1
RAG_LLM_TIMEOUT=300
RAG_LLM_MAX_TOKENS=0
RAG_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
RAG_OPENAI_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434
GEMINI_API_KEY=
RAG_INDEX_VERSION=10
RAG_DENSE_MODEL=intfloat/multilingual-e5-large
RAG_DENSE_DIM=1024
RAG_SPARSE_MODEL=Qdrant/bm25
RAG_RERANK_MODEL=BAAI/bge-reranker-base
RAG_RERANK_SCORE_MODE=sigmoid
RAG_RERANK_RELEVANCE_WEIGHT=0.68
RAG_RERANK_AUTHORITY_WEIGHT=0.20
RAG_RERANK_JURISDICTION_WEIGHT=0.12
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_CANDIDATES_K=60
RAG_FINAL_K=8
RAG_MAX_CONTEXT_CHARS=26000
RAG_MIN_EVIDENCE_SCORE=0.20
RAG_SYNC_SOURCES=1
RAG_SYNC_JURISPRUDENCIA=1
RAG_PRUNE_STALE=1
# Deixe vazio para usar o pacote temático padrão. Para uma única consulta, defina RAG_JURISPRUDENCIA_QUERY.
RAG_JURISPRUDENCIA_QUERY=
# Consultas separadas por |. Cada consulta busca até RAG_JURISPRUDENCIA_LIMIT por tribunal.
# RAG_JURISPRUDENCIA_QUERIES=Lei 14.133 licitação contrato administrativo|contratação direta dispensa inexigibilidade|edital habilitação qualificação técnica
RAG_JURISPRUDENCIA_LIMIT=12
RAG_JURISPRUDENCIA_DETAIL=0
RAG_JURISPRUDENCIA_WITH_CONTENT=0
# RAG_FASTEMBED_PROVIDERS=CUDAExecutionProvider
