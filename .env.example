# Copie para .env e ajuste. Nunca commite o .env real (contém chaves de API).
# Trocar apenas estas variáveis NÃO exige reindexação (o índice é independente do LLM).

# --- Provedor de LLM: ollama | openai_compatible | gemini ---
RAG_LLM_PROVIDER=ollama
RAG_LLM_MODEL=qwen2.5:7b
RAG_LLM_TEMPERATURE=0.1
RAG_LLM_TIMEOUT=300

# --- Ollama local (padrão para rodar 100% offline na GPU local) ---
OLLAMA_HOST=http://localhost:11434

# --- Qualquer endpoint OpenAI-compatible (LM Studio, vLLM, llama.cpp server, OpenRouter etc.) ---
RAG_OPENAI_BASE_URL=http://localhost:1234/v1
RAG_OPENAI_API_KEY=

# --- Gemini (opcional, uso remoto) ---
GEMINI_API_KEY=

# --- Retrieval/index (mudar QUALQUER uma destas exige reindexação: rm -rf db/qdrant db/index_manifest.json && python ingest.py) ---
RAG_INDEX_VERSION=3
RAG_DENSE_MODEL=intfloat/multilingual-e5-large
RAG_DENSE_DIM=1024
RAG_SPARSE_MODEL=Qdrant/bm25
RAG_RERANK_MODEL=BAAI/bge-reranker-base
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_CANDIDATES_K=60
RAG_FINAL_K=8
RAG_MAX_CONTEXT_CHARS=26000

# --- GPU local (RTX 5060 Ti 16GB): habilita FastEmbed via CUDA ---
# RAG_FASTEMBED_PROVIDERS=CUDAExecutionProvider
