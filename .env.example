# Copie para .env. Nunca commite o .env real.
# O LLM é intercambiável e não faz parte do índice.

RAG_LLM_PROVIDER=openai_compatible
RAG_LLM_MODEL=local
RAG_LLM_TEMPERATURE=0.1
RAG_LLM_TIMEOUT=300

# llama.cpp / LM Studio / vLLM / OpenRouter
RAG_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
RAG_OPENAI_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434
GEMINI_API_KEY=

# Recuperação/index: alterações exigem reindexação.
RAG_INDEX_VERSION=6
RAG_DENSE_MODEL=intfloat/multilingual-e5-large
RAG_DENSE_DIM=1024
RAG_SPARSE_MODEL=Qdrant/bm25
RAG_RERANK_MODEL=BAAI/bge-reranker-base
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_CANDIDATES_K=60
RAG_FINAL_K=8
RAG_MAX_CONTEXT_CHARS=26000

# Sincroniza fontes oficiais antes da indexação.
RAG_SYNC_SOURCES=1

# GPU local, ex.: RTX 5060 Ti 16 GB.
# RAG_FASTEMBED_PROVIDERS=CUDAExecutionProvider
