# Copie para .env. Nunca commite o .env real.
RAG_LLM_PROVIDER=openai_compatible
RAG_LLM_MODEL=local
RAG_LLM_TEMPERATURE=0.1
RAG_LLM_TIMEOUT=300
RAG_LLM_MAX_TOKENS=0
RAG_AI_CHUNKING_ENABLED=1
# Exija a IA para jurisprudência/matérias; 0 permite que ela seja pulada.
RAG_AI_CHUNKING_REQUIRED=1
# Falha do LLM semântico cai para chunking estrutural sem perder o documento.
RAG_AI_CHUNKING_FALLBACK_TO_STRUCTURAL=1
RAG_AI_CHUNKING_MIN_CHARS=1800
RAG_AI_CHUNKING_WINDOW_CHARS=9000
RAG_AI_CHUNKING_ATTEMPTS=2
RAG_AI_CHUNKING_PROMPT_VERSION=1
# Por padrão herda o provedor/modelo de resposta. Configure um LLM menor aqui para reduzir custo/latência.
# RAG_AI_CHUNKING_PROVIDER=ollama
# RAG_AI_CHUNKING_MODEL=seu-modelo-local
RAG_AI_CHUNKING_TEMPERATURE=0.0
RAG_AI_CHUNKING_TIMEOUT=120
RAG_AI_CHUNKING_MAX_TOKENS=512
RAG_OPENAI_BASE_URL=http://127.0.0.1:8888/v1
RAG_OPENAI_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434
RAG_OLLAMA_NUM_CTX=16384
GEMINI_API_KEY=
RAG_INDEX_VERSION=16
RAG_DENSE_MODEL=intfloat/multilingual-e5-large
RAG_DENSE_DIM=1024
RAG_DENSE_MAX_TOKENS=512
RAG_SPARSE_MODEL=Qdrant/bm25
RAG_RERANK_MODEL=BAAI/bge-reranker-base
RAG_RERANK_SCORE_MODE=sigmoid
RAG_RERANK_RELEVANCE_WEIGHT=0.68
RAG_RERANK_AUTHORITY_WEIGHT=0.20
RAG_RERANK_JURISDICTION_WEIGHT=0.12
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_CANDIDATES_K=60
RAG_FINAL_K=6
RAG_MAX_CONTEXT_CHARS=16000
RAG_QDRANT_UPSERT_BATCH_SIZE=100
RAG_MIN_EVIDENCE_SCORE=0.20
RAG_EVIDENCE_TOKEN_OVERLAP=0.25
RAG_EVIDENCE_STEM_OVERLAP=0.20
RAG_EVIDENCE_MIN_SHARED_STEMS=2
RAG_SYNC_SOURCES=1
RAG_SYNC_JURISPRUDENCIA=1
RAG_PRUNE_STALE=1
# Deixe vazio para usar o pacote temático padrão. Para uma única consulta, defina RAG_JURISPRUDENCIA_QUERY.
RAG_JURISPRUDENCIA_QUERY=
# Consultas separadas por |. O limite abaixo é o alvo total por tribunal; cada consulta busca no máximo 25 por tribunal.
# RAG_JURISPRUDENCIA_QUERIES=Lei 14.133 licitação contrato administrativo|contratação direta dispensa inexigibilidade|edital habilitação qualificação técnica
RAG_JURISPRUDENCIA_LIMIT=200
RAG_JURISPRUDENCIA_MIN_RECORDS_PER_TRIBUNAL=150
RAG_JURISPRUDENCIA_DETAIL=0
RAG_JURISPRUDENCIA_WITH_CONTENT=0
RAG_JURISPRUDENCIA_STRICT=1
# CUDA é o padrão. Para execução CPU: RAG_FASTEMBED_REQUIRE_CUDA=0 e RAG_FASTEMBED_PROVIDERS=CPUExecutionProvider
RAG_FASTEMBED_PROVIDERS=CUDAExecutionProvider
RAG_FASTEMBED_REQUIRE_CUDA=1
RAG_OCR_ENABLED=1
# Use 1 para exigir OCR quando uma página não atingir os limites de extração nativa.
RAG_OCR_REQUIRED=0
RAG_OCR_MIN_NATIVE_CHARS_PER_PAGE=80
RAG_OCR_MIN_NATIVE_CONFIDENCE=0.60
RAG_OCR_DPI=250
RAG_OCR_LANGUAGE=por+eng
